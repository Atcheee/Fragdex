{
  "name": "this-or-that-fragrance-games",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run generate:catalog && npm run generate:atlas",
    "generate:catalog": "tsx scripts/build-catalog-db.ts",
    "generate:atlas": "tsx scripts/generate-fragrance-atlas.ts",
    "predev": "node scripts/ensure-catalog-db.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "refresh:fragrantica": "tsx scripts/refresh-fragrantica.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@imgly/background-removal-node": "^1.4.5",
    "@phosphor-icons/react": "^2.1.10",
    "gsap": "^3.15.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "sharp": "$sharp"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "onnxruntime-node",
      "sharp",
      "unrs-resolver"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@9.15.9",
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
