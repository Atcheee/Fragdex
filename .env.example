# Public Supabase project settings (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Required for permanent self-service account deletion and
# community clone-accuracy voting (guest + signed-in votes).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Existing production deployment; no custom domain is required.
NEXT_PUBLIC_SITE_URL=https://fragdex.vercel.app

# Optional. HTTPS URL for the fragrance atlas JSON (e.g. Vercel Blob).
# Falls back to /data/fragrance-atlas.json for local gitignored builds.
# NEXT_PUBLIC_ATLAS_URL=https://YOUR_BLOB_STORE.public.blob.vercel-storage.com/fragrance-atlas.json

# Runtime catalog (Turso). Required in production.
# TURSO_DATABASE_URL=libsql://YOUR_DB.turso.io
# TURSO_AUTH_TOKEN=REPLACE_ME
