# Public Supabase project settings (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Required solely for permanent self-service account deletion.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Existing production deployment; no custom domain is required.
NEXT_PUBLIC_SITE_URL=https://fragrance-games.vercel.app
