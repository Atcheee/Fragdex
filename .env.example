# Public Supabase project settings (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Required for permanent self-service account deletion and
# community clone-accuracy voting (guest + signed-in votes).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Existing production deployment; no custom domain is required.
NEXT_PUBLIC_SITE_URL=https://fragdex.vercel.app

# Vercel Blob (private store). /api/atlas reads data/fragrance-atlas.json from here.
# Connect the store to the Fragdex Vercel project (Storage → Blob → Projects),
# then `vercel env pull`. Upload map data with: npm run upload:atlas
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME
# BLOB_STORE_ID=YOUR_STORE_ID
# Optional overrides:
# ATLAS_BLOB_PATH=data/fragrance-atlas.json
# ATLAS_BLOB_URL=https://YOUR_STORE_ID.private.blob.vercel-storage.com/data/fragrance-atlas.json
# BLOB_ATLAS_BASE_URL=https://YOUR_STORE_ID.private.blob.vercel-storage.com

# Runtime catalog (Turso). Required in production.
# TURSO_DATABASE_URL=libsql://YOUR_DB.turso.io
# TURSO_AUTH_TOKEN=REPLACE_ME
